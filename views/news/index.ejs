<%- include('../partials/head') %>

<!-- ═══════════════════ EN-TÊTE PAGE NEWS ═══════════════════ -->
<section class="news-hero">
  <div class="container">
    <div class="news-hero-inner">
      <div class="news-hero-icon"><i class="fas fa-newspaper"></i></div>
      <div>
        <h1 class="news-hero-title"><%= t('page.news_page_title') %></h1>
        <p class="news-hero-subtitle"><%= t('page.news_page_subtitle') %></p>
      </div>
    </div>
  </div>
</section>

<!-- ═══════════════════ LISTE DES ANNONCES ═══════════════════ -->
<section class="section news-section">
  <div class="container">

    <% if (announcements.length === 0) { %>
      <div class="news-empty">
        <div class="news-empty-icon"><i class="fas fa-inbox"></i></div>
        <h2><%= t('page.no_announcements') %></h2>
        <p><%= t('page.no_announcements_subtitle') %></p>
      </div>
    <% } else { %>
      <div class="news-list">
        <% announcements.forEach(function(a) { %>
          <article class="news-card">
            <div class="news-card-meta">
              <span class="news-card-date">
                <i class="fas fa-calendar-alt"></i>
                <%= new Date(a.created_at).toLocaleDateString(locale, {
                  day:   'numeric',
                  month: 'long',
                  year:  'numeric'
                }) %>
              </span>
            </div>
            <h2 class="news-card-title">
              <a href="/news/<%= a.id %>"><%= a.title %></a>
            </h2>
            <div class="news-card-footer">
              <a href="/news/<%= a.id %>" class="btn btn--ghost btn--sm">
                <i class="fas fa-arrow-right"></i> <%= t('news.read_more') %>
              </a>
            </div>
          </article>
        <% }); %>
      </div>
    <% } %>

  </div>
</section>

<%- include('../partials/foot') %>
