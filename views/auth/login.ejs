<%- include('../partials/head') %>

<div class="auth-container">
  <div class="auth-card">
    <!-- En-tête -->
    <div class="auth-card-header">
      <div class="auth-icon">
        <i class="fas fa-right-to-bracket"></i>
      </div>
      <h1 class="auth-title"><%= t('auth.login') %></h1>
      <p class="auth-subtitle"><%= t('auth.subtitle_login') %></p>
    </div>

    <!-- Erreurs de validation -->
    <% if (errors && errors.length > 0) { %>
      <div class="form-errors" role="alert">
        <% errors.forEach(function(err) { %>
          <p class="form-error-msg"><i class="fas fa-triangle-exclamation"></i> <%= err.msg %></p>
        <% }); %>
      </div>
    <% } %>

    <!-- Formulaire de connexion -->
    <form action="/auth/login" method="POST" class="auth-form" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken() %>" />

      <div class="form-group">
        <label for="email" class="form-label">
          <i class="fas fa-envelope"></i> <%= t('auth.email') %>
        </label>
        <input
          type="email"
          id="email"
          name="email"
          class="form-input"
          value="<%= old.email || '' %>"
          placeholder="votre@email.com"
          required
          autocomplete="email"
        />
      </div>

      <div class="form-group">
        <label for="password" class="form-label">
          <i class="fas fa-lock"></i> <%= t('auth.password') %>
        </label>
        <div class="input-password-wrap">
          <input
            type="password"
            id="password"
            name="password"
            class="form-input"
            placeholder="••••••••"
            required
            autocomplete="current-password"
          />
          <button type="button" class="password-toggle" aria-label="<%= t('auth.toggle_password_visibility') %>">
            <i class="fas fa-eye"></i>
          </button>
        </div>
      </div>

      <button type="submit" class="btn btn--primary btn--full">
        <i class="fas fa-right-to-bracket"></i> <%= t('auth.sign_in') %>
      </button>
    </form>

    <% if (discordEnabled) { %>
      <!-- Séparateur -->
      <div class="auth-divider">
        <span><%= t('auth.or') %></span>
      </div>

      <!-- Connexion via Discord -->
      <a href="/auth/discord" class="btn btn--discord btn--full">
        <i class="fab fa-discord"></i> <%= t('auth.login_with_discord') %>
      </a>
    <% } %>

    <!-- Lien vers l'inscription -->
    <div class="auth-switch">
      <p><%= t('auth.no_account') %> <a href="/auth/register" class="link-accent"><%= t('auth.create_account') %></a></p>
    </div>
  </div>
</div>

<%- include('../partials/foot') %>
