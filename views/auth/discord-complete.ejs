<%- include('../partials/head') %>

<div class="auth-container">
  <div class="auth-card">
    <!-- En-tête -->
    <div class="auth-card-header">
      <div class="auth-icon auth-icon--discord">
        <i class="fab fa-discord"></i>
      </div>
      <h1 class="auth-title"><%= t('auth.complete_discord_signup') %></h1>
      <p class="auth-subtitle"><%= t('auth.discord_connected_complete_profile') %></p>
    </div>

    <!-- Erreurs de validation -->
    <% if (errors && errors.length > 0) { %>
      <div class="form-errors" role="alert">
        <% errors.forEach(function(err) { %>
          <p class="form-error-msg"><i class="fas fa-triangle-exclamation"></i> <%= err.msg %></p>
        <% }); %>
      </div>
    <% } %>

    <!-- Formulaire de complétion -->
    <form action="/auth/discord/complete" method="POST" class="auth-form" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken() %>" />

      <div class="form-row">
        <div class="form-group">
          <label for="last_name" class="form-label">
            <i class="fas fa-id-card"></i> <%= t('auth.last_name') %>
          </label>
          <input
            type="text"
            id="last_name"
            name="last_name"
            class="form-input"
            value="<%= old.last_name || '' %>"
            placeholder="Dupont"
            required
            autocomplete="family-name"
            maxlength="100"
          />
        </div>

        <div class="form-group">
          <label for="first_name" class="form-label">
            <i class="fas fa-id-card"></i> <%= t('auth.first_name') %>
          </label>
          <input
            type="text"
            id="first_name"
            name="first_name"
            class="form-input"
            value="<%= old.first_name || '' %>"
            placeholder="Jean"
            required
            autocomplete="given-name"
            maxlength="100"
          />
        </div>
      </div>

      <div class="form-group">
        <label for="username" class="form-label">
          <i class="fas fa-gamepad"></i> <%= t('auth.username_label') %>
        </label>
        <input
          type="text"
          id="username"
          name="username"
          class="form-input"
          value="<%= old.username || '' %>"
          placeholder="ProGamer42"
          required
          minlength="2"
          maxlength="50"
          autocomplete="nickname"
        />
        <small class="form-hint">
          <% if (old.username) { %>
            <i class="fab fa-discord"></i> <%= t('auth.prefilled_from_discord') %>
          <% } else { %>
            <%= t('auth.username_hint') %>
          <% } %>
        </small>
      </div>

      <div class="form-group">
        <label for="email" class="form-label">
          <i class="fas fa-envelope"></i> <%= t('auth.email') %>
        </label>
        <input
          type="email"
          id="email"
          name="email"
          class="form-input"
          value="<%= old.email || '' %>"
          placeholder="votre@email.com"
          required
          autocomplete="email"
        />
        <small class="form-hint"><%= t('auth.email_privacy_hint') %></small>
      </div>

      <button type="submit" class="btn btn--discord btn--full">
        <i class="fab fa-discord"></i> <%= t('auth.create_my_account') %>
      </button>
    </form>

    <!-- Lien retour -->
    <div class="auth-switch">
      <p><%= t('common.cancel') %> ? <a href="/auth/register" class="link-accent"><%= t('auth.back_to_register') %></a></p>
    </div>
  </div>
</div>

<%- include('../partials/foot') %>
