<%- include('partials/head') %>

<div class="profile-container container">
  <div class="profile-header">
    <div class="profile-avatar">
      <i class="fas fa-circle-user"></i>
    </div>
    <div class="profile-info">
      <h1 class="profile-name"><%= user.username %></h1>
      <p class="profile-meta"><%= user.first_name %> <%= user.last_name %></p>
      <% if (user.is_admin) { %>
        <span class="badge badge--admin"><i class="fas fa-shield-halved"></i> <%= t('profile.badge_admin') %></span>
      <% } else if (user.is_moderator) { %>
        <span class="badge badge--moderator"><i class="fas fa-user-shield"></i> <%= t('profile.badge_moderator') %></span>
      <% } else { %>
        <span class="badge badge--member"><i class="fas fa-user"></i> <%= t('profile.badge_member') %></span>
      <% } %>
    </div>
  </div>

  <!-- Onglets -->
  <div class="profile-tabs" role="tablist">
    <button class="tab-btn<%= (typeof activeTab === 'undefined' || activeTab === 'info') ? ' active' : '' %>"
            role="tab" data-tab="tab-info" aria-selected="<%= (typeof activeTab === 'undefined' || activeTab === 'info') ? 'true' : 'false' %>">
      <i class="fas fa-user-pen"></i> <%= t('profile.tab_info') %>
    </button>
    <button class="tab-btn<%= (typeof activeTab !== 'undefined' && activeTab === 'password') ? ' active' : '' %>"
            role="tab" data-tab="tab-password" aria-selected="<%= (typeof activeTab !== 'undefined' && activeTab === 'password') ? 'true' : 'false' %>">
      <i class="fas fa-key"></i> <%= t('profile.tab_password') %>
    </button>
    <button class="tab-btn<%= (typeof activeTab !== 'undefined' && activeTab === 'events') ? ' active' : '' %>"
            role="tab" data-tab="tab-events" aria-selected="<%= (typeof activeTab !== 'undefined' && activeTab === 'events') ? 'true' : 'false' %>">
      <i class="fas fa-calendar-days"></i> <%= t('profile.tab_events') %>
    </button>
    <button class="tab-btn<%= (typeof activeTab !== 'undefined' && activeTab === 'badge') ? ' active' : '' %>"
            role="tab" data-tab="tab-badge" aria-selected="<%= (typeof activeTab !== 'undefined' && activeTab === 'badge') ? 'true' : 'false' %>">
      <i class="fas fa-id-card"></i> <%= t('profile.tab_badge') %>
    </button>
  </div>

  <!-- Erreurs de validation -->
  <% if (errors && errors.length > 0) { %>
    <div class="form-errors" role="alert">
      <% errors.forEach(function(err) { %>
        <p class="form-error-msg"><i class="fas fa-triangle-exclamation"></i> <%= err.msg %></p>
      <% }); %>
    </div>
  <% } %>

  <!-- Panneau : Informations -->
  <div id="tab-info" class="tab-panel<%= (typeof activeTab === 'undefined' || activeTab === 'info') ? ' active' : '' %>" role="tabpanel">
    <div class="card">
      <div class="card-header">
        <h2><i class="fas fa-user-pen"></i> <%= t('profile.edit_info') %></h2>
      </div>
      <div class="card-body">
        <form action="/profile" method="POST" class="profile-form" novalidate>
          <input type="hidden" name="_csrf" value="<%= csrfToken() %>" />

          <div class="form-row">
            <div class="form-group">
              <label for="last_name" class="form-label"><%= t('profile.field_last_name') %></label>
              <input type="text" id="last_name" name="last_name" class="form-input"
                value="<%= user.last_name || '' %>" required maxlength="100" />
            </div>
            <div class="form-group">
              <label for="first_name" class="form-label"><%= t('profile.field_first_name') %></label>
              <input type="text" id="first_name" name="first_name" class="form-input"
                value="<%= user.first_name || '' %>" required maxlength="100" />
            </div>
          </div>

          <div class="form-group">
                 <label for="username" class="form-label">
              <i class="fas fa-gamepad"></i> <%= t('profile.field_username') %>
            </label>
                 <input type="text" id="username" name="username" class="form-input"
                   value="<%= user.username || '' %>" required minlength="2" maxlength="50" />
            <small class="form-hint"><%= t('profile.field_username_hint') %></small>
          </div>

          <div class="form-group">
            <label for="email" class="form-label">
              <i class="fas fa-envelope"></i> <%= t('profile.field_email') %>
            </label>
            <input type="email" id="email" name="email" class="form-input"
                   value="<%= user.email || '' %>" required autocomplete="email" />
          </div>

          <div class="form-group">
            <label for="discord_user_id" class="form-label">
              <i class="fab fa-discord"></i> <%= t('profile.field_discord_id') %>
            </label>
            <input type="text" id="discord_user_id" name="discord_user_id" class="form-input font-monospace"
                   value="<%= user.discord_user_id || '' %>" maxlength="20"
                   placeholder="ex: 123456789012345678" autocomplete="off" />
            <small class="form-hint">
              <%- t('profile.field_discord_id_hint') %>
            </small>
          </div>

          <div class="form-actions">
            <button type="submit" class="btn btn--primary">
              <i class="fas fa-floppy-disk"></i> <%= t('profile.save') %>
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Panneau : Mot de passe -->
  <div id="tab-password" class="tab-panel<%= (typeof activeTab !== 'undefined' && activeTab === 'password') ? ' active' : '' %>" role="tabpanel">
    <div class="card">
      <div class="card-header">
        <h2><i class="fas fa-key"></i> <%= t('profile.change_password_title') %></h2>
      </div>
      <div class="card-body">
        <form action="/profile/password" method="POST" class="profile-form" novalidate>
          <input type="hidden" name="_csrf" value="<%= csrfToken() %>" />

          <div class="form-group">
            <label for="current_password" class="form-label"><%= t('profile.field_current_password') %></label>
            <div class="input-password-wrap">
              <input type="password" id="current_password" name="current_password"
                     class="form-input" placeholder="••••••••" required autocomplete="current-password" />
              <button type="button" class="password-toggle" aria-label="<%= t('profile.show_hide_password') %>">
                <i class="fas fa-eye"></i>
              </button>
            </div>
          </div>

          <div class="form-group">
            <label for="new_password" class="form-label"><%= t('profile.field_new_password') %></label>
            <div class="input-password-wrap">
              <input type="password" id="new_password" name="new_password"
                     class="form-input" placeholder="••••••••" required minlength="8"
                     autocomplete="new-password" />
              <button type="button" class="password-toggle" aria-label="<%= t('profile.show_hide_password') %>">
                <i class="fas fa-eye"></i>
              </button>
            </div>
            <small class="form-hint"><%= t('profile.field_new_password_hint') %></small>
          </div>

          <div class="form-group">
            <label for="new_password_confirm" class="form-label"><%= t('profile.field_confirm_password') %></label>
            <div class="input-password-wrap">
              <input type="password" id="new_password_confirm" name="new_password_confirm"
                     class="form-input" placeholder="••••••••" required autocomplete="new-password" />
              <button type="button" class="password-toggle" aria-label="<%= t('profile.show_hide_password') %>">
                <i class="fas fa-eye"></i>
              </button>
            </div>
          </div>

          <div class="form-actions">
            <button type="submit" class="btn btn--primary">
              <i class="fas fa-key"></i> <%= t('profile.change_password_btn') %>
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Panneau : Événements -->
  <div id="tab-events" class="tab-panel<%= (typeof activeTab !== 'undefined' && activeTab === 'events') ? ' active' : '' %>" role="tabpanel">

    <!-- Événement à venir ou en cours -->
    <% if (activeEvent) { %>
    <div class="card" style="margin-bottom: var(--space-md);">
      <div class="card-header">
        <h2><i class="fas fa-calendar-star"></i> <%= t('profile.next_event') %></h2>
      </div>
      <div class="card-body">
        <h3 style="margin-bottom: var(--space-sm);"><%= activeEvent.name %></h3>
        <p>
          <i class="fas fa-calendar-alt"></i>
          <%= new Date(activeEvent.start_at).toLocaleDateString(locale, {
            weekday: 'long', day: 'numeric', month: 'long', year: 'numeric'
          }) %>
          <%= t('common.at') %>
          <%= new Date(activeEvent.start_at).toLocaleTimeString(locale, {
            hour: '2-digit', minute: '2-digit'
          }) %>
        </p>
        <p><i class="fas fa-location-dot"></i> <%= activeEvent.location %></p>

        <% if (isRegistered) { %>
          <div class="event-registered-badge" style="margin: var(--space-md) 0;">
            <i class="fas fa-circle-check"></i> <%= t('profile.registered_badge') %>
          </div>
          <!-- Bouton d'accès au badge électronique -->
          <div style="margin-bottom: var(--space-md);">
            <a href="/profile/events/<%= activeEvent.id %>/badge" class="btn btn--primary btn--sm">
              <i class="fas fa-ticket"></i> <%= t('profile.view_electronic_badge') %>
            </a>
          </div>
          <% if (registrationOpen) { %>
            <form action="/profile/events/<%= activeEvent.id %>/unregister" method="POST">
              <input type="hidden" name="_csrf" value="<%= csrfToken() %>" />
              <button type="submit" class="btn btn--ghost btn--sm"
                      onclick="return confirm('<%= t(\'profile.confirm_unregister_event\') %>')">
                <i class="fas fa-user-minus"></i> <%= t('profile.cancel_registration_btn') %>
              </button>
            </form>
          <% } else { %>
            <p class="form-hint"><i class="fas fa-lock"></i> <%= t('profile.registrations_closed_hint') %></p>
          <% } %>
        <% } else if (registrationOpen) { %>
          <form action="/profile/events/<%= activeEvent.id %>/register" method="POST">
            <input type="hidden" name="_csrf" value="<%= csrfToken() %>" />
            <button type="submit" class="btn btn--primary">
              <i class="fas fa-user-plus"></i> <%= t('profile.register_btn') %>
            </button>
          </form>
        <% } else { %>
            <p class="form-hint"><i class="fas fa-lock"></i> <%= t('profile.registrations_closed_hint') %></p>
        <% } %>
      </div>
    </div>
    <% } else { %>
    <div class="card" style="margin-bottom: var(--space-md);">
      <div class="card-body">
        <p class="text-muted text-center">
          <i class="fas fa-calendar-xmark"></i> <%= t('profile.no_active_event') %>
        </p>
      </div>
    </div>
    <% } %>

    <!-- Historique des inscriptions -->
    <div class="card">
      <div class="card-header">
        <h2><i class="fas fa-history"></i> <%= t('profile.my_registrations') %></h2>
      </div>
      <div class="card-body">
        <% if (!userRegistrations || userRegistrations.length === 0) { %>
          <p class="text-muted text-center">
            <i class="fas fa-inbox"></i> <%= t('profile.no_registrations_msg') %>
          </p>
        <% } else { %>
          <div class="table-responsive">
            <table class="data-table">
              <thead>
                <tr>
                  <th><%= t('profile.col_event') %></th>
                  <th><%= t('profile.col_date') %></th>
                  <th><%= t('profile.col_location') %></th>
                  <th><%= t('profile.col_status') %></th>
                  <th><%= t('profile.col_registered_on') %></th>
                </tr>
              </thead>
              <tbody>
                <% userRegistrations.forEach(function(r) { %>
                  <tr>
                    <td><strong><%= r.name %></strong></td>
                    <td class="td-date">
                      <%= new Date(r.start_at).toLocaleDateString(locale, {
                        day: '2-digit', month: '2-digit', year: 'numeric'
                      }) %>
                    </td>
                    <td><%= r.location %></td>
                    <td>
                      <% if (r.status === 'planned') { %>
                        <span class="badge badge--admin"><i class="fas fa-calendar-check"></i> <%= t('status.planned') %></span>
                      <% } else if (r.status === 'in_progress') { %>
                        <span class="badge badge--member"><i class="fas fa-circle-play"></i> <%= t('status.in_progress') %></span>
                      <% } else { %>
                        <span class="badge badge--draft"><i class="fas fa-circle-check"></i> <%= t('status.ended') %></span>
                      <% } %>
                    </td>
                    <td class="td-date">
                      <%= new Date(r.created_at).toLocaleDateString(locale) %>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>
    </div>

  </div>

  <!-- Panneau : Badge de membre -->
  <div id="tab-badge" class="tab-panel<%= (typeof activeTab !== 'undefined' && activeTab === 'badge') ? ' active' : '' %>" role="tabpanel">
    <div class="card">
      <div class="card-header">
        <h2><i class="fas fa-id-card"></i> <%= t('profile.my_badge_title') %></h2>
      </div>
      <div class="card-body" style="text-align: center; padding: var(--space-xl);">
        <p class="form-hint" style="margin-bottom: var(--space-lg);">
          <i class="fas fa-circle-info"></i>
          <%= t('profile.badge_description') %>
        </p>
        <div style="display: flex; gap: var(--space-sm); justify-content: center; flex-wrap: wrap;">
          <a href="/profile/badge" class="btn btn--primary">
            <i class="fas fa-id-card"></i> <%= t('profile.view_badge_btn') %>
          </a>
          <a href="/profile/badge" target="_blank" class="btn btn--ghost">
            <i class="fas fa-external-link-alt"></i> <%= t('profile.open_new_tab') %>
          </a>
        </div>
        <p class="form-hint" style="margin-top: var(--space-md);">
          <i class="fas fa-print"></i> <%= t('profile.print_pdf_hint') %>
        </p>
      </div>
    </div>
  </div>

  <!-- Infos compte -->
  <div class="card profile-meta-card">
    <div class="card-body profile-meta-info">
      <div class="meta-item">
        <span class="meta-label"><i class="fas fa-calendar-plus"></i> Membre depuis</span>
        <span class="meta-value"><%= new Date(user.created_at).toLocaleDateString(locale, { year: 'numeric', month: 'long', day: 'numeric' }) %></span>
      </div>
      <% if (user.updated_at) { %>
      <div class="meta-item">
        <span class="meta-label"><i class="fas fa-pen-to-square"></i> Dernière modification</span>
        <span class="meta-value"><%= new Date(user.updated_at).toLocaleDateString(locale, { year: 'numeric', month: 'long', day: 'numeric' }) %></span>
      </div>
      <% } %>
    </div>
  </div>
</div>

<%- include('partials/foot') %>
