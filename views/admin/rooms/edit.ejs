<%- include('../../partials/head') %>

<div class="container admin-container">
  <div class="admin-layout">
    <%- include('../_sidebar', { activeSection: 'rooms' }) %>

    <section class="admin-main">

  <div class="admin-header">
    <div>
      <h1 class="admin-title">
        <i class="fas fa-pen"></i> <%= t('common.edit') %> - <%= room.name %>
      </h1>
    </div>
    <div class="admin-header-actions">
      <a href="/admin/rooms?event_id=<%= room.event_id %>" class="btn btn--ghost btn--sm">
        <i class="fas fa-arrow-left"></i> <%= t('admin.rooms_back_list') %>
      </a>
    </div>
  </div>

  <div class="card">
    <div class="card-body">
      <% if (errors.length > 0) { %>
        <div class="alert alert--error">
          <ul style="margin:0; padding-left:1.2rem;">
            <% errors.forEach(function(e) { %><li><%= e.msg %></li><% }); %>
          </ul>
        </div>
      <% } %>

      <form action="/admin/rooms/<%= room.id %>?_method=PUT" method="POST" class="form-grid">
        <input type="hidden" name="_csrf" value="<%= csrfToken() %>" />

        <div class="form-group">
          <label class="form-label"><%= t('admin.room_event') %></label>
          <p class="form-static">
            <i class="fas fa-calendar-days"></i>
            <%= events.find(e => e.id === room.event_id) ? events.find(e => e.id === room.event_id).name : 'Événement #' + room.event_id %>
          </p>
        </div>

        <div class="form-group">
             <label class="form-label" for="name"><%= t('admin.room_name') %> <span class="required">*</span></label>
             <input type="text" id="name" name="name" class="form-input"
               value="<%= old.name || '' %>"
                 maxlength="100" required />
        </div>

        <div class="form-group">
          <label class="form-label" for="type"><%= t('admin.room_type') %> <span class="required">*</span></label>
          <select id="type" name="type" class="form-select" required>
            <% ROOM_TYPES.forEach(function(t) { %>
              <option value="<%= t %>" <%= old.type === t ? 'selected' : '' %>>
                <%= t === 'simulation' ? t('admin.room_type_simulation') : t('admin.room_type_console') %>
              </option>
            <% }); %>
          </select>
        </div>

        <div class="form-group">
          <label class="form-label" for="match_type"><%= t('admin.room_match_format') %> <span class="required">*</span></label>
          <select id="match_type" name="match_type" class="form-select" required>
            <% MATCH_TYPES.forEach(function(t) { %>
              <option value="<%= t %>" <%= old.match_type === t ? 'selected' : '' %>>
                <%= t === '2v2' ? t('admin.room_match_format_2v2') : t === '1v1' ? t('admin.room_match_format_1v1') : t('admin.room_match_format_solo') %>
              </option>
            <% }); %>
          </select>
        </div>

        <div class="form-group">
          <label class="form-label"><%= t('moderator.status_label') %></label>
          <label class="form-checkbox">
            <input type="checkbox" name="is_active" value="1" <%= (old.is_active == '1' || old.is_active === 1) ? 'checked' : '' %> />
            <%= t('admin.room_is_active') %>
          </label>
        </div>

        <div class="form-actions">
          <button type="submit" class="btn btn--primary">
            <i class="fas fa-save"></i> <%= t('common.save') %>
          </button>
          <a href="/admin/rooms?event_id=<%= room.event_id %>" class="btn btn--ghost"><%= t('common.cancel') %></a>
        </div>
      </form>
    </div>
  </div>

    </section>
  </div>

</div>

<%- include('../../partials/foot') %>
