<%- include('../partials/head') %>

<div class="container admin-container">
  <div class="admin-layout">
    <%- include('./_sidebar', { activeSection: 'members' }) %>

    <section class="admin-main">
      <div class="admin-header">
        <div>
          <h1 class="admin-title">
            <i class="fas fa-shield-halved"></i> <%= t('admin.panel_title') %>
          </h1>
          <p class="admin-subtitle"><%= t('admin.member_management') %></p>
        </div>
      </div>

      <div class="stats-grid">
        <a href="/admin#users-table" class="stat-card stat-card--link" aria-label="Voir la liste des membres">
          <div class="stat-icon stat-icon--total"><i class="fas fa-users"></i></div>
          <div class="stat-info">
            <span class="stat-number"><%= totalUsers %></span>
            <span class="stat-label"><%= t('admin.total_members') %></span>
          </div>
        </a>
        <a href="/admin#users-table" class="stat-card stat-card--link" aria-label="Voir les administrateurs">
          <div class="stat-icon stat-icon--admin"><i class="fas fa-shield-halved"></i></div>
          <div class="stat-info">
            <span class="stat-number"><%= stats.admins %></span>
            <span class="stat-label"><%= t('admin.total_admins') %></span>
          </div>
        </a>
        <a href="/admin#users-table" class="stat-card stat-card--link" aria-label="Voir les modérateurs">
          <div class="stat-icon stat-icon--moderator"><i class="fas fa-user-shield"></i></div>
          <div class="stat-info">
            <span class="stat-number"><%= stats.moderators %></span>
            <span class="stat-label"><%= t('admin.total_moderators') %></span>
          </div>
        </a>
        <a href="/admin#users-table" class="stat-card stat-card--link" aria-label="Voir les membres standard">
          <div class="stat-icon stat-icon--member"><i class="fas fa-user"></i></div>
          <div class="stat-info">
            <span class="stat-number"><%= stats.members %></span>
            <span class="stat-label"><%= t('admin.total_members_label') %></span>
          </div>
        </a>
        <a href="/admin/news" class="stat-card stat-card--link" aria-label="Accéder au CRUD des annonces">
          <div class="stat-icon stat-icon--news"><i class="fas fa-newspaper"></i></div>
          <div class="stat-info">
            <span class="stat-number"><%= totalAnnouncements %></span>
            <span class="stat-label"><%= t('admin.announcements_count') %></span>
          </div>
        </a>
        <a href="/admin/events" class="stat-card stat-card--link" aria-label="Accéder au CRUD des événements">
          <div class="stat-icon stat-icon--total"><i class="fas fa-calendar-days"></i></div>
          <div class="stat-info">
            <span class="stat-number"><%= totalEvents %></span>
            <span class="stat-label"><%= t('admin.events_count') %></span>
          </div>
        </a>
      </div>

      <div class="card admin-users-card" id="users-table">
        <div class="card-header admin-card-header">
          <h2><i class="fas fa-users-gear"></i> <%= t('admin.users_table_title') %></h2>
        </div>
        <div class="card-body">
          <div class="table-responsive">
            <table class="data-table">
              <thead>
                <tr>
                  <th>ID</th>
                  <th><%= t('admin.table_user_pseudo') %></th>
                  <th><%= t('admin.table_full_name') %></th>
                  <th><%= t('admin.table_email') %></th>
                  <th><%= t('admin.table_role') %></th>
                  <th><%= t('admin.table_registration_date') %></th>
                  <th><%= t('common.actions') %></th>
                </tr>
              </thead>
              <tbody>
                <% if (users.length === 0) { %>
                  <tr>
                    <td colspan="7" class="table-empty"><%= t('admin.no_users_found') %></td>
                  </tr>
                <% } else { %>
                  <% users.forEach(function(u) { %>
                    <tr class="<%= u.id === currentUser.id ? 'row--current' : '' %>">
                      <td class="td-id">#<%= u.id %></td>
                      <td>
                        <span class="user-pseudo">
                          <i class="fas fa-circle-user"></i> <%= u.username %>
                        </span>
                        <% if (u.id === currentUser.id) { %>
                          <span class="badge badge--you"><%= t('admin.table_you') %></span>
                        <% } %>
                      </td>
                      <td><%= u.first_name %> <%= u.last_name %></td>
                      <td><a href="mailto:<%= u.email %>" class="link-muted"><%= u.email %></a></td>
                      <td>
                        <% if (u.is_admin) { %>
                          <span class="badge badge--admin"><i class="fas fa-shield-halved"></i> Admin</span>
                        <% } else if (u.is_moderator) { %>
                          <span class="badge badge--moderator"><i class="fas fa-user-shield"></i> Modérateur</span>
                        <% } else { %>
                          <span class="badge badge--member"><i class="fas fa-user"></i> Membre</span>
                        <% } %>
                      </td>
                      <td class="td-date">
                        <%= new Date(u.created_at).toLocaleDateString(locale) %>
                      </td>
                      <td class="td-actions">
                        <a href="/admin/users/<%= u.id %>/badge" class="btn btn--xs btn--ghost" title="<%= t('admin.view_badge') %>">
                          <i class="fas fa-id-card"></i> <%= t('admin.view_badge') %>
                        </a>

                        <% if (u.id !== currentUser.id) { %>
                          <form action="/admin/users/<%= u.id %>/toggle-admin" method="POST" class="inline-form">
                            <input type="hidden" name="_csrf" value="<%= csrfToken() %>" />
                            <button type="submit"
                                    class="btn btn--xs <%= u.is_admin ? 'btn--warning' : 'btn--info' %>"
                                    title="<%= u.is_admin ? t('admin.demote_admin') : t('admin.promote_admin') %>"
                                  onclick='return confirm(<%- JSON.stringify(u.is_admin ? t("admin.confirm_demote_admin").replace("{{name}}", u.username) : t("admin.confirm_promote_admin").replace("{{name}}", u.username)) %>)'>
                              <i class="fas <%= u.is_admin ? 'fa-user-minus' : 'fa-user-shield' %>"></i>
                              <%= u.is_admin ? t('admin.demote_admin') : t('admin.promote_admin') %>
                            </button>
                          </form>

                          <% if (!u.is_admin) { %>
                          <form action="/admin/users/<%= u.id %>/toggle-moderator" method="POST" class="inline-form">
                            <input type="hidden" name="_csrf" value="<%= csrfToken() %>" />
                            <button type="submit"
                                    class="btn btn--xs <%= u.is_moderator ? 'btn--warning' : 'btn--secondary' %>"
                                    title="<%= u.is_moderator ? t('admin.demote_moderator') : t('admin.promote_moderator') %>"
                                  onclick='return confirm(<%- JSON.stringify(u.is_moderator ? t("admin.confirm_demote_mod").replace("{{name}}", u.username) : t("admin.confirm_promote_mod").replace("{{name}}", u.username)) %>)'>
                              <i class="fas <%= u.is_moderator ? 'fa-user-minus' : 'fa-user-check' %>"></i>
                              <%= u.is_moderator ? t('admin.demote_moderator') : t('admin.promote_moderator') %>
                            </button>
                          </form>
                          <% } %>

                          <form action="/admin/users/<%= u.id %>/delete" method="POST" class="inline-form">
                            <input type="hidden" name="_csrf" value="<%= csrfToken() %>" />
                            <button type="submit"
                                    class="btn btn--xs btn--danger"
                                    title="<%= t('admin.delete_user_title') %>"
                                    onclick='return confirm(<%- JSON.stringify(t("admin.confirm_delete_user").replace("{{name}}", u.username)) %>)'>
                              <i class="fas fa-trash"></i> <%= t('common.delete') %>
                            </button>
                          </form>
                        <% } else { %>
                          <span class="text-muted text-sm">—</span>
                        <% } %>
                      </td>
                    </tr>
                  <% }); %>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>
  </div>
</div>

<%- include('../partials/foot') %>
