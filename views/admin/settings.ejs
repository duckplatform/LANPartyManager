<%- include('../partials/head') %>

<div class="container admin-container">
  <div class="admin-layout">
    <%- include('./_sidebar', { activeSection: 'settings' }) %>

    <section class="admin-main">

      <!-- En-tête -->
      <div class="admin-header">
        <div>
          <h1 class="admin-title">
            <i class="fas fa-sliders"></i> <%= t('settings.page_title') %>
          </h1>
          <p class="admin-subtitle">
            <%= t('settings.page_subtitle') %>
          </p>
        </div>
      </div>

      <!-- Erreurs de validation -->
      <% if (typeof errors !== 'undefined' && errors && errors.length > 0) { %>
        <div class="form-errors">
          <% errors.forEach(function(e) { %>
            <p class="form-error-msg"><i class="fas fa-exclamation-circle"></i> <%= e.msg %></p>
          <% }); %>
        </div>
      <% } %>

      <!-- Formulaire -->
      <form action="/admin/settings" method="POST" class="news-form" novalidate>
        <input type="hidden" name="_csrf" value="<%= csrfToken() %>" />

        <div class="news-form-layout">

          <!-- ── Colonne principale ── -->
          <div class="news-form-main">

            <!-- Section Identité du site -->
            <div class="card" style="margin-bottom: var(--space-lg);">
              <div class="card-header">
                <h2><i class="fas fa-building"></i> <%= t('settings.section_identity') %></h2>
              </div>
              <div class="card-body">

                <!-- Nom du site -->
                <div class="form-group">
                  <label class="form-label" for="organization_name">
                    <i class="fas fa-heading"></i> <%= t('settings.field_org_name') %>
                  </label>
                  <input
                    type="text"
                    id="organization_name"
                    name="organization_name"
                    class="form-input"
                    placeholder="<%= t('settings.field_org_name_placeholder') %>"
                    value="<%= (settings && settings.organization_name) ? settings.organization_name : 'LANPartyManager' %>"
                    maxlength="255"
                    required
                  />
                  <span class="form-hint">
                    <%= t('settings.field_org_name_hint') %>
                  </span>
                </div>

                <!-- Slogan -->
                <div class="form-group">
                  <label class="form-label" for="organization_slogan">
                    <i class="fas fa-quote-left"></i> <%= t('settings.field_slogan') %>
                  </label>
                  <input
                    type="text"
                    id="organization_slogan"
                    name="organization_slogan"
                    class="form-input"
                    placeholder="<%= t('settings.field_slogan_placeholder') %>"
                    value="<%= (settings && settings.organization_slogan) ? settings.organization_slogan : '' %>"
                    maxlength="255"
                  />
                  <span class="form-hint">
                    <%= t('settings.field_slogan_hint') %>
                  </span>
                </div>

                <!-- Logo -->
                <div class="form-group">
                  <label class="form-label" for="organization_logo">
                    <i class="fas fa-image"></i> <%= t('settings.field_logo') %>
                  </label>
                  <input
                    type="url"
                    id="organization_logo"
                    name="organization_logo"
                    class="form-input"
                    placeholder="<%= t('settings.field_logo_placeholder') %>"
                    value="<%= (settings && settings.organization_logo) ? settings.organization_logo : '' %>"
                    maxlength="500"
                  />
                  <span class="form-hint">
                    <%= t('settings.field_logo_hint') %>
                    <% if (settings && settings.organization_logo) { %>
                      <div style="margin-top: var(--space-sm);">
                        <img src="<%= settings.organization_logo %>" alt="Logo" style="max-height: 60px; max-width: 200px; border: 1px solid var(--color-border); border-radius: 4px; padding: 4px;" />
                      </div>
                    <% } %>
                  </span>
                </div>

              </div>
            </div>

            <!-- Section Liens communautés -->
            <div class="card" style="margin-bottom: var(--space-lg);">
              <div class="card-header">
                <h2><i class="fas fa-share-alt"></i> <%= t('settings.section_community') %></h2>
              </div>
              <div class="card-body">
                <p class="form-hint" style="margin-bottom: var(--space-md);">
                  <%= t('settings.section_community_hint') %>
                </p>

                <!-- Discord -->
                <div class="form-group">
                  <label class="form-label" for="community_link_discord">
                    <i class="fab fa-discord"></i> Discord
                  </label>
                  <input
                    type="url"
                    id="community_link_discord"
                    name="community_link_discord"
                    class="form-input"
                    placeholder="<%= t('settings.field_discord_link_placeholder') %>"
                    value="<%= (settings && settings.community_link_discord) ? settings.community_link_discord : '' %>"
                    maxlength="500"
                  />
                  <span class="form-hint">
                    <%= t('settings.field_discord_link_hint') %>
                  </span>
                </div>

                <!-- Twitter -->
                <div class="form-group">
                  <label class="form-label" for="community_link_twitter">
                    <i class="fab fa-twitter"></i> Twitter / X
                  </label>
                  <input
                    type="url"
                    id="community_link_twitter"
                    name="community_link_twitter"
                    class="form-input"
                    placeholder="<%= t('settings.field_twitter_placeholder') %>"
                    value="<%= (settings && settings.community_link_twitter) ? settings.community_link_twitter : '' %>"
                    maxlength="500"
                  />
                  <span class="form-hint">
                    <%= t('settings.field_twitter_hint') %>
                  </span>
                </div>

                <!-- Twitch -->
                <div class="form-group">
                  <label class="form-label" for="community_link_twitch">
                    <i class="fab fa-twitch"></i> Twitch
                  </label>
                  <input
                    type="url"
                    id="community_link_twitch"
                    name="community_link_twitch"
                    class="form-input"
                    placeholder="<%= t('settings.field_twitch_placeholder') %>"
                    value="<%= (settings && settings.community_link_twitch) ? settings.community_link_twitch : '' %>"
                    maxlength="500"
                  />
                  <span class="form-hint">
                    <%= t('settings.field_twitch_hint') %>
                  </span>
                </div>

                <!-- YouTube -->
                <div class="form-group">
                  <label class="form-label" for="community_link_youtube">
                    <i class="fab fa-youtube"></i> YouTube
                  </label>
                  <input
                    type="url"
                    id="community_link_youtube"
                    name="community_link_youtube"
                    class="form-input"
                    placeholder="<%= t('settings.field_youtube_placeholder') %>"
                    value="<%= (settings && settings.community_link_youtube) ? settings.community_link_youtube : '' %>"
                    maxlength="500"
                  />
                  <span class="form-hint">
                    <%= t('settings.field_youtube_hint') %>
                  </span>
                </div>

                <!-- Website -->
                <div class="form-group">
                  <label class="form-label" for="community_link_website">
                    <i class="fas fa-globe"></i> <%= t('settings.field_website') %>
                  </label>
                  <input
                    type="url"
                    id="community_link_website"
                    name="community_link_website"
                    class="form-input"
                    placeholder="<%= t('settings.field_website_placeholder') %>"
                    value="<%= (settings && settings.community_link_website) ? settings.community_link_website : '' %>"
                    maxlength="500"
                  />
                  <span class="form-hint">
                    <%= t('settings.field_website_hint') %>
                  </span>
                </div>

              </div>
            </div>

            <!-- Section Langue et localisation -->
            <div class="card" style="margin-bottom: var(--space-lg);">
              <div class="card-header">
                <h2><i class="fas fa-language"></i> <%= t('settings.section_localization') %></h2>
              </div>
              <div class="card-body">

                <!-- Langue de l'interface -->
                <div class="form-group">
                  <label class="form-label" for="language">
                    <i class="fas fa-globe"></i> <%= t('settings.field_language') %>
                  </label>
                  <select id="language" name="language" class="form-input">
                    <option value="fr" <%= (!settings || !settings.language || settings.language === 'fr') ? 'selected' : '' %>>
                      🇫🇷 Français
                    </option>
                    <option value="en" <%= (settings && settings.language === 'en') ? 'selected' : '' %>>
                      🇬🇧 English
                    </option>
                  </select>
                  <span class="form-hint">
                    <%= t('settings.field_language_hint') %>
                  </span>
                </div>

                <!-- Locale BCP 47 pour les dates -->
                <div class="form-group">
                  <label class="form-label" for="locale">
                    <i class="fas fa-calendar-days"></i> <%= t('settings.locale') %>
                  </label>
                  <input
                    type="text"
                    id="locale"
                    name="locale"
                    class="form-input"
                    placeholder="<%= t('settings.locale_placeholder') %>"
                    value="<%= (settings && settings.locale) ? settings.locale : 'fr-FR' %>"
                    maxlength="20"
                    pattern="[a-zA-Z]{2,3}(-[a-zA-Z]{2,4})?"
                  />
                  <span class="form-hint">
                    <%- t('settings.field_locale_hint_full') %>
                    <% if (settings && settings.locale) { %>
                      <br><%= t('settings.locale_preview_label') %> <strong id="localePreview">…</strong>
                      <script>
                        (function() {
                          const input   = document.getElementById('locale');
                          const preview = document.getElementById('localePreview');
                          function updatePreview() {
                            try {
                              preview.textContent = new Date().toLocaleDateString(
                                input.value.trim() || 'fr-FR',
                                { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' }
                              );
                            } catch(e) {
                              preview.textContent = "<%= t('settings.locale_invalid') %>";
                            }
                          }
                          input.addEventListener('input', updatePreview);
                          updatePreview();
                        })();
                      </script>
                    <% } %>
                  </span>
                </div>

              </div>
            </div>

            <!-- Section Discord -->
            <div class="card" style="margin-bottom: var(--space-lg);">
              <div class="card-header">
                <h2><i class="fab fa-discord"></i> <%= t('settings.section_discord') %></h2>
              </div>
              <div class="card-body">

                <!-- Activer/désactiver Discord -->
                <div class="form-group">
                  <label class="form-label">
                    <i class="fas fa-toggle-on"></i> <%= t('settings.field_discord_toggle') %>
                  </label>
                  <div style="display: flex; align-items: center; gap: var(--space-sm); margin-top: var(--space-xs);">
                    <input
                      type="checkbox"
                      id="discord_enabled"
                      name="discord_enabled"
                      value="1"
                      <%= (settings && settings.discord_enabled === '1') ? 'checked' : '' %>
                      style="width: 1.2rem; height: 1.2rem; cursor: pointer;"
                    />
                    <label for="discord_enabled" style="cursor: pointer; font-weight: normal;">
                      <%= t('settings.field_discord_toggle_text') %>
                    </label>
                  </div>
                  <span class="form-hint">
                    <%= t('settings.field_discord_toggle_hint') %>
                  </span>
                </div>

                <!-- Token bot -->
                <div class="form-group">
                  <label class="form-label" for="discord_bot_token">
                    <i class="fas fa-robot"></i> <%= t('settings.field_bot_token') %>
                  </label>
                  <input
                    type="password"
                    id="discord_bot_token"
                    name="discord_bot_token"
                    class="form-input"
                    placeholder="<%= (settings && settings.discord_bot_token) ? '••••••••••••••••••••••••••••••••••' : t('settings.field_bot_token_placeholder') %>"
                    maxlength="200"
                    autocomplete="off"
                  />
                  <span class="form-hint">
                    <%= t('settings.field_bot_token_hint') %>
                    <% if (settings && settings.discord_bot_token) { %>
                      <span style="color: var(--color-success);">
                        <i class="fas fa-check-circle"></i> <%= t('settings.token_configured') %>
                      </span>
                    <% } else { %>
                      <span style="color: var(--color-warning);">
                        <i class="fas fa-exclamation-triangle"></i> <%= t('settings.not_configured') %>
                      </span>
                    <% } %>
                  </span>
                  <% if (settings && settings.discord_bot_token) { %>
                    <label style="display: flex; align-items: center; gap: 0.5rem; margin-top: var(--space-xs); font-size: 0.85rem; cursor: pointer; color: var(--color-danger);">
                      <input type="checkbox" name="clear_discord_bot_token" id="clear_discord_bot_token" value="1" />
                      <%= t('settings.reset_token') %>
                    </label>
                  <% } %>
                </div>

                <!-- Canal actualités -->
                <div class="form-group">
                  <label class="form-label" for="discord_channel_news">
                    <i class="fas fa-newspaper"></i> <%= t('settings.field_news_channel') %>
                  </label>
                  <input
                    type="text"
                    id="discord_channel_news"
                    name="discord_channel_news"
                    class="form-input"
                    placeholder="<%= t('settings.field_news_channel_placeholder') %>"
                    value="<%= (settings && settings.discord_channel_news) ? settings.discord_channel_news : '' %>"
                    maxlength="20"
                    inputmode="numeric"
                    pattern="[0-9]{17,20}"
                    autocomplete="off"
                  />
                  <span class="form-hint">
                    <%= t('settings.field_news_channel_hint') %>
                  </span>
                </div>

                <hr style="border-color: var(--color-border); margin: var(--space-md) 0;" />

                <!-- OAuth2 Discord -->
                <h3 style="font-size: 1rem; font-weight: 600; margin-bottom: var(--space-md);">
                  <i class="fas fa-key"></i> <%= t('settings.section_oauth2') %>
                </h3>
                <p class="form-hint" style="margin-bottom: var(--space-md);">
                  <%- t('settings.section_oauth2_hint') %>
                </p>
                <% if (settings && settings.discord_enabled === '1' && (!settings.discord_client_id || !settings.discord_client_secret)) { %>
                  <div style="background: var(--color-warning-bg, #fff8e1); border: 1px solid var(--color-warning, #f0b429); border-radius: var(--radius-sm, 4px); padding: var(--space-sm); margin-bottom: var(--space-md); font-size: 0.875rem;">
                    <i class="fas fa-exclamation-triangle" style="color: var(--color-warning, #f0b429);"></i>
                    <%= t('settings.oauth2_warning') %>
                  </div>
                <% } %>

                <!-- Client ID -->
                <div class="form-group">
                  <label class="form-label" for="discord_client_id">
                    <i class="fas fa-fingerprint"></i> Client ID
                  </label>
                  <input
                    type="text"
                    id="discord_client_id"
                    name="discord_client_id"
                    class="form-input"
                    placeholder="Ex. : 123456789012345678"
                    value="<%= (settings && settings.discord_client_id) ? settings.discord_client_id : '' %>"
                    maxlength="20"
                    inputmode="numeric"
                    pattern="[0-9]{17,20}"
                    autocomplete="off"
                  />
                  <span class="form-hint">
                    <%= t('settings.field_client_id_hint') %>
                    <% if (settings && settings.discord_client_id) { %>
                      <span style="color: var(--color-success);">
                        <i class="fas fa-check-circle"></i> <%= t('settings.configured') %>
                      </span>
                    <% } %>
                  </span>
                </div>

                <!-- Client Secret -->
                <div class="form-group">
                  <label class="form-label" for="discord_client_secret">
                    <i class="fas fa-lock"></i> Client Secret
                  </label>
                  <input
                    type="password"
                    id="discord_client_secret"
                    name="discord_client_secret"
                    class="form-input"
                    placeholder="<%= (settings && settings.discord_client_secret) ? '••••••••••••••••••••••••••••••••' : t('settings.field_client_secret_placeholder') %>"
                    maxlength="100"
                    autocomplete="off"
                    data-configured="<%= (settings && settings.discord_client_secret) ? 'true' : 'false' %>"
                  />
                  <span class="form-hint">
                    <%= t('settings.field_client_secret_hint') %>
                    <% if (settings && settings.discord_client_secret) { %>
                      <span style="color: var(--color-success);">
                        <i class="fas fa-check-circle"></i> <%= t('settings.secret_configured') %>
                      </span>
                    <% } else { %>
                      <span style="color: var(--color-warning);">
                        <i class="fas fa-exclamation-triangle"></i> <%= t('settings.not_configured') %>
                      </span>
                    <% } %>
                  </span>
                  <% if (settings && settings.discord_client_secret) { %>
                    <label style="display: flex; align-items: center; gap: 0.5rem; margin-top: var(--space-xs); font-size: 0.85rem; cursor: pointer; color: var(--color-danger);">
                      <input type="checkbox" name="clear_discord_client_secret" id="clear_discord_client_secret" value="1" />
                      <%= t('settings.reset_secret') %>
                    </label>
                  <% } %>
                </div>

                <hr style="border-color: var(--color-border); margin: var(--space-md) 0;" />

                <!-- Slash Commands -->
                <h3 style="font-size: 1rem; font-weight: 600; margin-bottom: var(--space-md);">
                  <i class="fas fa-terminal"></i> <%= t('settings.section_slash_commands') %>
                </h3>
                <p class="form-hint" style="margin-bottom: var(--space-md);">
                  <%- t('settings.slash_commands_desc') %>
                </p>

                <!-- Clé publique -->
                <div class="form-group">
                  <label class="form-label" for="discord_application_public_key">
                    <i class="fas fa-shield-alt"></i> <%= t('settings.field_public_key') %>
                  </label>
                  <input
                    type="text"
                    id="discord_application_public_key"
                    name="discord_application_public_key"
                    class="form-input"
                    placeholder="<%= t('settings.field_public_key_placeholder') %>"
                    value="<%= (settings && settings.discord_application_public_key) ? settings.discord_application_public_key : '' %>"
                    maxlength="64"
                    pattern="[0-9a-fA-F]{64}"
                    autocomplete="off"
                    style="font-family: monospace; font-size: 0.85rem;"
                  />
                  <span class="form-hint">
                    <%= t('settings.field_public_key_hint') %>
                    <% if (settings && settings.discord_application_public_key) { %>
                      <span style="color: var(--color-success);">
                        <i class="fas fa-check-circle"></i> <%= t('settings.public_key_configured') %>
                      </span>
                    <% } else { %>
                      <span style="color: var(--color-warning);">
                        <i class="fas fa-exclamation-triangle"></i> <%= t('settings.public_key_not_configured') %>
                      </span>
                    <% } %>
                    <br>
                    <%= t('settings.interaction_url_label') %><br>
                    <code style="font-size: 0.75rem; word-break: break-all;">
                      <%= appUrl || 'https://votre-domaine.example.com' %>/discord/interactions
                    </code>
                  </span>
                </div>

              </div>
            </div>

          </div>

          <!-- ── Barre latérale ── -->
          <aside class="news-form-sidebar">

            <!-- Actions -->
            <div class="card sidebar-card">
              <div class="card-header">
                <h2><i class="fas fa-save"></i> <%= t('settings.save_card') %></h2>
              </div>
              <div class="card-body">
                <div class="form-actions">
                  <button type="submit" class="btn btn--primary btn--full">
                    <i class="fas fa-save"></i> <%= t('settings.save_button') %>
                  </button>
                </div>
                <div style="margin-top: var(--space-md); padding-top: var(--space-md); border-top: 1px solid var(--color-border);">
                  <a href="/admin" class="btn btn--ghost btn--full btn--sm">
                    <i class="fas fa-arrow-left"></i> <%= t('settings.back') %>
                  </a>
                </div>
              </div>
            </div>

            <!-- Commandes Slash -->
            <div class="card sidebar-card">
              <div class="card-header">
                <h2><i class="fas fa-terminal"></i> <%= t('settings.slash_commands_card') %></h2>
              </div>
              <div class="card-body">
                <p style="font-size: 0.875rem; margin-bottom: var(--space-sm);">
                  <%= t('settings.slash_commands_register_desc') %>
                </p>
                <p style="font-size: 0.8rem; color: var(--color-text-muted); margin-bottom: var(--space-md);">
                  <%= t('settings.slash_commands_available') %> <code>/classement</code>, <code>/position</code>,
                  <code>/statistiques</code>, <code>/evenement</code>
                </p>
                <% if (settings && settings.discord_client_id && (settings.discord_bot_token || process.env.DISCORD_BOT_TOKEN)) { %>
                  <button
                    type="submit"
                    class="btn btn--ghost btn--full btn--sm"
                    form="discordRegisterCommandsForm"
                    formnovalidate
                  >
                    <i class="fab fa-discord"></i> <%= t('settings.register_commands_btn') %>
                  </button>
                <% } else { %>
                  <p style="font-size: 0.8rem; color: var(--color-warning);">
                    <i class="fas fa-exclamation-triangle"></i>
                    <%- t('settings.slash_commands_missing_config') %>
                  </p>
                <% } %>
              </div>
            </div>

            <!-- Guide Discord -->
            <div class="card sidebar-card">
              <div class="card-header">
                <h2><i class="fas fa-circle-info"></i> <%= t('settings.discord_guide_card') %></h2>
              </div>
              <div class="card-body">
                <ol style="padding-left: var(--space-md); font-size: 0.875rem; line-height: 1.6;">
                  <li><%- t('settings.discord_guide_step1') %></li>
                  <li><%- t('settings.discord_guide_step2') %></li>
                  <li><%- t('settings.discord_guide_step3') %><br>
                    <code style="font-size: 0.75rem; word-break: break-all;">
                      <%= appUrl || 'https://votre-domaine.example.com' %>/auth/discord/callback
                    </code>
                  </li>
                  <li><%- t('settings.discord_guide_step4') %></li>
                  <li><%- t('settings.discord_guide_step5') %></li>
                  <li><%- t('settings.discord_guide_step6') %><br>
                    <code style="font-size: 0.75rem; word-break: break-all;">
                      <%= appUrl || 'https://votre-domaine.example.com' %>/discord/interactions
                    </code>
                  </li>
                  <li><%- t('settings.discord_guide_step7') %></li>
                  <li><%- t('settings.discord_guide_step8') %></li>
                  <li><%- t('settings.discord_guide_step9') %></li>
                </ol>
                <div style="margin-top: var(--space-sm);">
                  <a href="/admin/discord-test" class="btn btn--ghost btn--full btn--sm">
                    <i class="fab fa-discord"></i> <%= t('settings.test_notifications_btn') %>
                  </a>
                </div>
              </div>
            </div>

          </aside>

        </div>
      </form>

      <form id="discordRegisterCommandsForm" action="/admin/discord/register-commands" method="POST" style="display: none;">
        <input type="hidden" name="_csrf" value="<%= csrfToken() %>" />
      </form>

      <script>
        document.addEventListener('DOMContentLoaded', function () {
          const settingsForm = document.querySelector('form[action="/admin/settings"]');
          const discordEnabledInput = document.getElementById('discord_enabled');
          const clientIdInput = document.getElementById('discord_client_id');
          const clientSecretInput = document.getElementById('discord_client_secret');

          if (!settingsForm || !discordEnabledInput || !clientIdInput || !clientSecretInput) return;

          settingsForm.addEventListener('submit', function (event) {
            const wantsDiscordEnabled = discordEnabledInput.checked;
            const hasClientId = clientIdInput.value.trim().length > 0;
            // Champ vide = conserver la valeur en base si elle est déjà configurée
            const secretAlreadyConfigured = clientSecretInput.dataset.configured === 'true';
            const hasClientSecret = clientSecretInput.value.trim().length > 0 || secretAlreadyConfigured;

            if (wantsDiscordEnabled && (!hasClientId || !hasClientSecret)) {
              event.preventDefault();
              alert("<%= t('settings.oauth2_alert') %>");
              (hasClientId ? clientSecretInput : clientIdInput).focus();
            }
          });
        });
      </script>

    </section>
  </div>
</div>

<%- include('../partials/foot') %>
