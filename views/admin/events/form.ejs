<%- include('../../partials/head') %>

<div class="container admin-container">
  <div class="admin-layout">
    <%- include('../_sidebar', { activeSection: 'events' }) %>

    <section class="admin-main">

  <!-- En-tête -->
  <div class="admin-header">
    <div>
      <h1 class="admin-title">
        <i class="fas fa-<%= event && event.id ? 'edit' : 'plus-circle' %>"></i>
        <%= event && event.id ? t('admin.event_form_title_edit') : t('admin.event_form_title_create') %>
      </h1>
      <p class="admin-subtitle"><%= t('admin.event_form_subtitle') %></p>
    </div>
    <div>
      <a href="/admin/events" class="btn btn--ghost btn--sm">
        <i class="fas fa-arrow-left"></i> <%= t('admin.events_list_title') %>
      </a>
    </div>
  </div>

  <!-- Erreurs de validation -->
  <% if (errors && errors.length > 0) { %>
    <div class="form-errors">
      <% errors.forEach(function(e) { %>
        <p class="form-error-msg"><i class="fas fa-exclamation-circle"></i> <%= e.msg %></p>
      <% }); %>
    </div>
  <% } %>

  <!-- Formulaire -->
  <form
    action="<%= event && event.id ? '/admin/events/' + event.id : '/admin/events' %>"
    method="POST"
    class="news-form"
    novalidate
  >
    <input type="hidden" name="_csrf" value="<%= csrfToken() %>" />

    <div class="news-form-layout">

      <!-- ── Colonne principale ── -->
      <div class="news-form-main">

        <!-- Nom -->
        <div class="form-group">
          <label class="form-label" for="name">
            <i class="fas fa-tag"></i> <%= t('admin.event_name') %> <span class="required">*</span>
          </label>
          <input
            type="text"
            id="name"
            name="name"
            class="form-input"
            placeholder="<%= t('admin.event_name_hint') %>"
            value="<%= (event && event.name) ? event.name : '' %>"
            maxlength="255"
            required
            autocomplete="off"
          />
        </div>

        <!-- Date/heure -->
        <div class="form-group">
          <label class="form-label" for="start_at">
            <i class="fas fa-calendar-alt"></i> <%= t('admin.event_date_time') %> <span class="required">*</span>
          </label>
          <input
            type="datetime-local"
            id="start_at"
            name="start_at"
            class="form-input"
            value="<%= dateHeureLocal || '' %>"
            required
          />
        </div>

        <!-- Lieu -->
        <div class="form-group">
          <label class="form-label" for="location">
            <i class="fas fa-location-dot"></i> <%= t('admin.event_location') %> <span class="required">*</span>
          </label>
          <input
            type="text"
            id="location"
            name="location"
            class="form-input"
            placeholder="<%= t('admin.event_location_hint') %>"
            value="<%= (event && event.location) ? event.location : '' %>"
            maxlength="255"
            required
            autocomplete="off"
          />
        </div>

        <!-- Canal Discord (affiché uniquement si Discord est activé globalement) -->
        <% if (typeof discordEnabled !== 'undefined' && discordEnabled) { %>
        <div class="form-group">
          <label class="form-label" for="discord_channel_id">
            <i class="fab fa-discord"></i> <%= t('admin.event_discord_channel') %>
          </label>
          <input
            type="text"
            id="discord_channel_id"
            name="discord_channel_id"
            class="form-input"
            placeholder="123456789012345678"
            value="<%= (event && event.discord_channel_id) ? event.discord_channel_id : '' %>"
            maxlength="32"
            inputmode="numeric"
            pattern="[0-9]{17,20}"
            autocomplete="off"
          />
          <span class="form-hint">
            <%= t('admin.event_discord_channel_hint') %>
          </span>
        </div>

        <!-- Activer/désactiver les notifications Discord pour cet événement -->
        <div class="form-group">
          <label class="form-label">
            <i class="fas fa-bell"></i> <%= t('admin.event_discord_notifications') %>
          </label>
          <div style="display: flex; align-items: center; gap: var(--space-sm); margin-top: var(--space-xs);">
            <input
              type="checkbox"
              id="discord_notifications_enabled"
              name="discord_notifications_enabled"
              value="1"
              <%
                // Activées par défaut (1) ou si l'option n'est pas encore définie
                const notifEnabled = (event && event.discord_notifications_enabled !== undefined)
                  ? (Number(event.discord_notifications_enabled) !== 0)
                  : true;
              %>
              <%= notifEnabled ? 'checked' : '' %>
              style="width: 1.2rem; height: 1.2rem; cursor: pointer;"
            />
            <label for="discord_notifications_enabled" style="cursor: pointer; font-weight: normal;">
              <%= t('admin.event_discord_notifications') %>
            </label>
          </div>
          <span class="form-hint">
            <%= t('admin.event_discord_notifications_hint') %>
          </span>
        </div>
        <% } %>

      </div>

      <!-- ── Barre latérale ── -->
      <aside class="news-form-sidebar">

        <!-- Statut -->
        <div class="card sidebar-card">
          <div class="card-header">
            <h2><i class="fas fa-tag"></i> Statut</h2>
          </div>
          <div class="card-body">
            <div class="form-group">
              <label class="form-label" for="status">
                <i class="fas fa-toggle-on"></i> <%= t('moderator.status_label') %>
              </label>
              <select id="status" name="status" class="form-input" required>
                <option value="planned"  <%= (!event || event.status === 'planned')  ? 'selected' : '' %>>
                  📅 <%= t('status.planned') %>
                </option>
                <option value="in_progress" <%= (event && event.status === 'in_progress') ? 'selected' : '' %>>
                  ▶ <%= t('status.in_progress') %>
                </option>
                <option value="ended"  <%= (event && event.status === 'ended')  ? 'selected' : '' %>>
                  ✅ <%= t('status.ended') %>
                </option>
              </select>
              <span class="form-hint">
                <strong>Planifié</strong> : l'événement est affiché sur le site et les inscriptions sont ouvertes jusqu'à la date de début.<br />
                <strong>En cours</strong> : l'événement est affiché, les inscriptions sont fermées.<br />
                <strong>Terminé</strong> : l'événement n'est plus mis en avant.
              </span>
            </div>

            <div class="form-actions">
              <button type="submit" class="btn btn--primary btn--full">
                <i class="fas fa-save"></i>
                <%= event && event.id ? t('common.save') : t('common.create') + ' ' + t('admin.events') %>
              </button>
            </div>

            <% if (event && event.id) { %>
              <div style="margin-top: var(--space-md); padding-top: var(--space-md); border-top: 1px solid var(--color-border);">
                <a href="/admin/events" class="btn btn--ghost btn--full btn--sm">
                  <i class="fas fa-times"></i> <%= t('common.cancel') %>
                </a>
              </div>
            <% } %>
          </div>
        </div>

        <!-- Note inscriptions -->
        <div class="card sidebar-card">
          <div class="card-header">
            <h2><i class="fas fa-circle-info"></i> <%= t('event.registrations') %></h2>
          </div>
          <div class="card-body">
            <p class="form-hint">
              <i class="fas fa-clock"></i>
              Les inscriptions sont automatiquement <strong>fermées à l'heure de début</strong>
              de l'événement, ou dès que le statut passe à « En cours » ou « Terminé ».
            </p>
            <% if (event && event.id) { %>
              <div style="margin-top: var(--space-sm);">
                <a href="/admin/events/<%= event.id %>/registrations" class="btn btn--ghost btn--full btn--sm">
                  <i class="fas fa-users"></i> <%= t('admin.event_registered') %>
                </a>
              </div>
            <% } %>
          </div>
        </div>

      </aside>

    </div>
  </form>

    </section>
  </div>

</div>

<%- include('../../partials/foot') %>
