<%- include('../../partials/head') %>

<div class="container admin-container">
  <div class="admin-layout">
    <%- include('../_sidebar', { activeSection: 'events' }) %>

    <section class="admin-main">

  <!-- En-tête admin -->
  <div class="admin-header">
    <div>
      <h1 class="admin-title">
        <i class="fas fa-users"></i> Inscrits — <%= event.name %>
      </h1>
      <p class="admin-subtitle">
        <i class="fas fa-calendar-alt"></i>
        <%= new Date(event.start_at).toLocaleDateString(locale, {
          weekday: 'long', day: 'numeric', month: 'long', year: 'numeric'
        }) %>
        <%- t('common.at') %>
        <%= new Date(event.start_at).toLocaleTimeString(locale, {
          hour: '2-digit', minute: '2-digit'
        }) %>
        &nbsp;—&nbsp;<i class="fas fa-location-dot"></i> <%= event.location %>
      </p>
    </div>
    <div class="admin-header-actions">
      <a href="/admin/events" class="btn btn--ghost btn--sm">
        <i class="fas fa-arrow-left"></i> <%= t('admin.events_list_title') %>
      </a>
      <a href="/admin/events/<%= event.id %>/edit" class="btn btn--warning btn--sm">
        <i class="fas fa-edit"></i> <%= t('admin.modify_event_btn') %>
      </a>
    </div>
  </div>

  <!-- Statistiques -->
  <div class="stats-grid" style="margin-bottom: var(--space-lg);">
    <div class="stat-card">
      <div class="stat-icon stat-icon--total"><i class="fas fa-users"></i></div>
      <div class="stat-info">
        <span class="stat-number"><%= registrations.length %></span>
        <span class="stat-label">Inscrits</span>
      </div>
    </div>
    <div class="stat-card">
      <div class="stat-icon stat-icon--<%= event.status === 'in_progress' ? 'member' : event.status === 'planned' ? 'admin' : 'news' %>">
        <i class="fas fa-<%= event.status === 'in_progress' ? 'circle-play' : event.status === 'planned' ? 'calendar-check' : 'circle-check' %>"></i>
      </div>
      <div class="stat-info">
        <span class="stat-number"><%= event.status === 'planned' ? t('status.planned') : event.status === 'in_progress' ? t('status.in_progress') : t('status.ended') %></span>
        <span class="stat-label"><%= t('admin.event_status_label') %></span>
      </div>
    </div>
    <div class="stat-card">
      <div class="stat-icon stat-icon--news"><i class="fas fa-clock"></i></div>
      <div class="stat-info">
        <span class="stat-number"><%= registrationOpen ? t('event.registrations_open') : t('event.registrations_closed') %></span>
        <span class="stat-label"><%= t('event.registrations') %></span>
      </div>
    </div>
  </div>

  <!-- Tableau des inscrits -->
  <div class="card admin-users-card">
    <div class="card-header admin-card-header">
      <h2><i class="fas fa-list"></i> <%= t('admin.registrations_list_title') %> (<%= registrations.length %>)</h2>
    </div>
    <div class="card-body">

      <!-- Ajout manuel -->
      <div style="margin-bottom: var(--space-md);">
        <form action="/admin/events/<%= event.id %>/registrations" method="POST" class="inline-form" style="display:flex;gap:.5rem;flex-wrap:wrap;">
          <input type="hidden" name="_csrf" value="<%= csrfToken() %>" />
          <select name="user_id" class="form-input" style="max-width:280px;" required>
            <option value=""><%= t('admin.select_member') %></option>
            <% availableUsers.forEach(function(u) { %>
              <option value="<%= u.id %>"><%= u.username %> (<%= u.email %>)</option>
            <% }); %>
          </select>
          <button type="submit" class="btn btn--primary btn--sm">
            <i class="fas fa-plus"></i> <%= t('admin.add_member_btn') %>
          </button>
        </form>
      </div>

      <div class="table-responsive">
        <table class="data-table">
          <thead>
            <tr>
              <th>#</th>
              <th><%= t('admin.table_user_pseudo') %></th>
              <th><%= t('admin.col_full_name') %></th>
              <th><%= t('admin.table_email') %></th>
              <th><%= t('profile.col_registered_on') %></th>
              <th><%= t('common.actions') %></th>
            </tr>
          </thead>
          <tbody>
            <% if (registrations.length === 0) { %>
              <tr>
                <td colspan="6" class="table-empty">
                  <i class="fas fa-inbox"></i> <%= t('admin.no_registrations_yet') %>
                </td>
              </tr>
            <% } else { %>
              <% registrations.forEach(function(r) { %>
                <tr>
                  <td class="td-id"><%= r.id %></td>
                  <td>
                    <span class="user-pseudo">
                      <i class="fas fa-circle-user"></i> <%= r.username %>
                    </span>
                  </td>
                  <td><%= r.first_name %> <%= r.last_name %></td>
                  <td><a href="mailto:<%= r.email %>" class="link-muted"><%= r.email %></a></td>
                  <td class="td-date">
                    <%= new Date(r.created_at).toLocaleDateString(locale) %>
                  </td>
                  <td class="td-actions">
                    <form action="/admin/events/<%= event.id %>/registrations/<%= r.id %>/delete" method="POST" class="inline-form">
                      <input type="hidden" name="_csrf" value="<%= csrfToken() %>" />
                      <button type="submit"
                              class="btn btn--xs btn--danger"
                              onclick="return confirm('<%= t('admin.confirm_unregister_member').replace('{{name}}', r.username) %>')">
                        <i class="fas fa-user-minus"></i> <%= t('common.delete') %>
                      </button>
                    </form>
                  </td>
                </tr>
              <% }); %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

    </section>
  </div>

</div>

<%- include('../../partials/foot') %>
