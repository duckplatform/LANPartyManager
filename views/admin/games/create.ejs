<%- include('../../partials/head') %>

<div class="container admin-container">
  <div class="admin-layout">
    <%- include('../_sidebar', { activeSection: 'games' }) %>

    <section class="admin-main">

  <div class="admin-header">
    <div>
      <h1 class="admin-title">
        <i class="fas fa-plus"></i> <%= t('admin.game_create_title') %>
      </h1>
    </div>
    <div class="admin-header-actions">
      <a href="/admin/games" class="btn btn--ghost btn--sm">
        <i class="fas fa-arrow-left"></i> <%= t('admin.back_to_games') %>
      </a>
    </div>
  </div>

  <div class="card">
    <div class="card-body">
      <% if (errors.length > 0) { %>
        <div class="alert alert--error">
          <ul style="margin:0; padding-left:1.2rem;">
            <% errors.forEach(function(e) { %><li><%= e.msg %></li><% }); %>
          </ul>
        </div>
      <% } %>

      <form action="/admin/games" method="POST" class="form-grid">
        <input type="hidden" name="_csrf" value="<%= csrfToken() %>" />

        <div class="form-group">
          <label class="form-label" for="name"><%= t('admin.field_game_name') %> <span class="required">*</span></label>
          <input type="text" id="name" name="name" class="form-input"
                 value="<%= old.name || '' %>"
                 placeholder="<%= t('admin.field_game_name_placeholder') %>"
                 maxlength="100" required />
        </div>

        <div class="form-group">
          <label class="form-label" for="console"><%= t('admin.field_console') %> <span class="required">*</span></label>
          <input type="text" id="console" name="console" class="form-input"
                 value="<%= old.console || '' %>"
                 placeholder="<%= t('admin.field_console_placeholder') %>"
                 maxlength="100" required />
        </div>

        <div class="form-group">
          <label class="form-label" for="match_type"><%= t('admin.field_match_format') %> <span class="required">*</span></label>
          <select id="match_type" name="match_type" class="form-select" required>
            <% MATCH_TYPES.forEach(function(t) { %>
              <option value="<%= t %>" <%= old.match_type === t ? 'selected' : '' %>>
                <%= t === '1v1' ? t('battle.format_1v1') : t === '2v2' ? t('battle.format_2v2') : t('battle.format_solo') %>
              </option>
            <% }); %>
          </select>
        </div>

        <div class="form-actions">
          <button type="submit" class="btn btn--primary">
            <i class="fas fa-save"></i> <%= t('common.save') %>
          </button>
          <a href="/admin/games" class="btn btn--ghost"><%= t('common.cancel') %></a>
        </div>
      </form>
    </div>
  </div>

    </section>
  </div>

</div>

<%- include('../../partials/foot') %>
