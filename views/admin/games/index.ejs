<%- include('../../partials/head') %>

<div class="container admin-container">
  <div class="admin-layout">
    <%- include('../_sidebar', { activeSection: 'games' }) %>

    <section class="admin-main">

  <!-- En-tête -->
  <div class="admin-header">
    <div>
      <h1 class="admin-title">
        <i class="fas fa-gamepad"></i> <%= t('admin.games_title') %>
      </h1>
      <p class="admin-subtitle"><%= t('admin.games_subtitle') %></p>
    </div>
    <div class="admin-header-actions">
      <a href="/admin/games/create" class="btn btn--primary btn--sm">
        <i class="fas fa-plus"></i> <%= t('admin.games_add_button') %>
      </a>
      <a href="/admin" class="btn btn--ghost btn--sm">
        <i class="fas fa-arrow-left"></i> <%= t('admin.dashboard') %>
      </a>
    </div>
  </div>

  <!-- Liste des jeux -->
  <div class="card admin-users-card">
    <div class="card-header admin-card-header">
      <h2><i class="fas fa-list"></i> <%= t('admin.games_list_title') %> (<%= games.length %>)</h2>
    </div>
    <div class="card-body">
      <div class="table-responsive">
        <table class="data-table">
          <thead>
            <tr>
              <th><%= t('admin.event_name') %></th>
              <th><%= t('admin.games_console') %></th>
              <th><%= t('admin.games_format') %></th>
              <th><%= t('common.actions') %></th>
            </tr>
          </thead>
          <tbody>
            <% if (games.length === 0) { %>
              <tr>
                <td colspan="4" class="table-empty">
                  <i class="fas fa-inbox"></i> <%= t('admin.no_games') %>
                  <a href="/admin/games/create"><%= t('admin.add_first_game') %></a>.
                </td>
              </tr>
            <% } else { %>
              <% games.forEach(function(game) { %>
                <tr>
                  <td><strong><%= game.name %></strong></td>
                  <td><i class="fas fa-desktop"></i> <%= game.console %></td>
                  <td>
                    <span class="badge badge--<%= game.match_type === '2v2' ? 'info' : 'primary' %>">
                      <i class="fas fa-users"></i> <%= game.match_type %>
                    </span>
                  </td>
                  <td class="td-actions">
                    <a href="/admin/games/<%= game.id %>/edit" class="btn btn--ghost btn--xs" title="<%= t('admin.games_edit') %>">
                      <i class="fas fa-pen"></i> <%= t('admin.games_edit') %>
                    </a>
                    <form action="/admin/games/<%= game.id %>?_method=DELETE" method="POST"
                          class="form-inline"
                          onsubmit="return confirm('<%= t('admin.games_delete_confirmation', { name: game.name }) %>')">
                      <input type="hidden" name="_csrf" value="<%= csrfToken() %>" />
                      <button type="submit" class="btn btn--danger btn--xs" title="<%= t('admin.games_delete') %>">
                        <i class="fas fa-trash"></i> <%= t('admin.games_delete') %>
                      </button>
                    </form>
                  </td>
                </tr>
              <% }); %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

    </section>
  </div>

</div>

<%- include('../../partials/foot') %>
