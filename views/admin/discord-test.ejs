<%- include('../partials/head', { title: 'Test Discord Mentions' }) %>

<div class="container admin-container">
  <div class="admin-layout">
    <%- include('./_sidebar', { activeSection: 'discord-test' }) %>

    <section class="admin-main">
      <div class="admin-header">
        <div>
          <h1 class="admin-title">
            <i class="fab fa-discord"></i> <%= t('admin.discord_test_title') %>
          </h1>
          <p class="admin-subtitle"><%= t('admin.discord_test_subtitle') %></p>
        </div>
      </div>

  <div class="row justify-content-center">
    <div class="col-lg-8">
      <div class="card">
        <div class="card-header bg-dark text-white">
          <h4 class="mb-0">🧪 <%= t('admin.discord_test_title') %></h4>
        </div>
        <div class="card-body">
          <%- include('../partials/flash') %>

          <p class="text-muted mb-4">
            <%= t('admin.discord_test_subtitle') %>
          </p>

          <form method="POST" action="/admin/discord-test">
            <input type="hidden" name="_csrf" value="<%= csrfToken() %>" />
            <div class="mb-3">
              <label class="form-label fw-bold"><%= t('admin.discord_test_channel_label') %></label>
              <input type="text" name="channel_id" class="form-control font-monospace"
                     placeholder="<%= t('admin.discord_test_channel_placeholder') %>"
                     value="<%= channelId || '' %>">
              <div class="form-text">
                <%= t('admin.discord_configured_channel') %> <code><%= configuredChannel || '(non configuré)' %></code>
              </div>
            </div>

            <div class="mb-3">
              <label class="form-label fw-bold"><%= t('admin.discord_pseudo_label') %></label>
              <input type="text" name="pseudo" class="form-control"
                     placeholder="ex: MonPseudo"
                     value="<%= pseudo || '' %>">
              <div class="form-text"><%= t('admin.discord_pseudo_hint') %></div>
            </div>

            <div class="mb-3">
              <label class="form-label fw-bold"><%= t('admin.discord_user_id_label') %></label>
              <input type="text" name="discord_id" class="form-control font-monospace"
                     placeholder="ex: 123456789012345678"
                     value="<%= discordId || '' %>">
              <div class="form-text">
                <%= t('admin.discord_user_id_hint') %>
                <br>
                <%= t('admin.discord_id_find_hint') %>
              </div>
            </div>

            <div class="d-flex gap-2">
              <button type="submit" class="btn btn-primary">
                📤 <%= t('admin.discord_send_test') %>
              </button>
              <a href="/admin/dashboard" class="btn btn-outline-secondary">Retour</a>
            </div>
          </form>

          <% if (typeof result !== 'undefined' && result) { %>
          <hr>
          <div class="alert <%= result.success ? 'alert-success' : 'alert-danger' %> mt-3">
            <strong><%= result.success ? '✅ Message envoyé !' : '❌ Erreur' %></strong>
            <% if (result.message) { %>
              <div class="mt-1"><%= result.message %></div>
            <% } %>
          </div>
          <% } %>

          <hr class="mt-4">
          <h6>📋 <%= t('admin.discord_formats_summary') %></h6>
          <table class="table table-sm table-bordered mt-2">
            <thead class="table-dark">
              <tr>
                <th><%= t('admin.discord_format_sent') %></th>
                <th><%= t('admin.discord_format_result') %></th>
                <th><%= t('admin.discord_format_notify') %></th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><code>@MonPseudo</code></td>
                <td><%= t('admin.discord_format_plain_result') %></td>
                <td class="text-danger">❌ Non</td>
              </tr>
              <tr>
                <td><code>&lt;@123456789012345678&gt;</code></td>
                <td><%= t('admin.discord_format_mention_result') %></td>
                <td class="text-success">✅ Oui</td>
              </tr>
              <tr>
                <td><code>@everyone</code></td>
                <td><%= t('admin.discord_format_everyone_result') %></td>
                <td class="text-success">✅ Oui (si autorisé)</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

    </section>
  </div>
</div>

<%- include('../partials/foot') %>
